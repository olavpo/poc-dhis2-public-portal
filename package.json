{
  "name": "dhis2-public-portal",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Generic static public-portal foundation for DHIS2 — Evidence + DuckDB-WASM, served from static files",
  "license": "BSD-3-Clause",
  "scripts": {
    "patch": "node evidence/scripts/patch-evidence.mjs",
    "sources": "npm --prefix evidence run sources",
    "duckdb:ext": "node scripts/fetch-duckdb-extensions.mjs",
    "build": "npm run patch && npm run duckdb:ext && npm run pages:asc && VITE_DUCKDB_EXT_REPO=/portal/duckdb-extensions npm --prefix evidence run build",
    "dev": "npm --prefix evidence run dev",
    "deploy": "bash scripts/deploy.sh",
    "push": "bash scripts/push-remote.sh",
    "serve": "bash scripts/serve.sh",
    "synth:asc": "node scripts/asc-synth/index.mjs",
    "extract:asc": "node scripts/dhis2-extract/index.mjs --config scripts/dhis2-extract/config/asc.yaml --out evidence/sources/census",
    "pages:asc": "node scripts/asc-pages/generate.mjs",
    "test": "vitest run"
  },
  "dependencies": {
    "yaml": "^2.5.0"
  },
  "devDependencies": {
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^4.1.9"
  }
}
